// @codingStandardsIgnoreFile
/**
 * @var \HiPay\FullserviceMagento\Block\Redirect\Pending $block
 */
?>
<?=  $block
        ->getLayout()
        ->createBlock('HiPay\FullserviceMagento\Block\ExternalJS')
        ->setTemplate('HiPay_FullserviceMagento::additional/external_js.phtml')
        ->toHtml()
?>
<div class="page-title">
    <h1><?= /* @escapeNotVerified */ __('Your payment is in pending.') ?></h1>
</div>

<?php if ($block->getRealOrderId()): ?><p>
    <?= /* @escapeNotVerified */ __('Order #') . $block->getRealOrderId() ?></p><?php endif ?>
<?php if ($error = $block->getErrorMessage()): ?><p><?= /* @escapeNotVerified */ $error ?></p><?php endif ?>
<?php if ($referenceToPay = $block->getReferenceToPay()): ?>
    <style>
        @media print {
            body * {
                visibility: hidden;
            }
            #referenceToPay,
            #referenceToPay * {
                visibility: visible;
            }
        }
    </style>
    <div class="referenceContainer">
        <div id="referenceToPay"></div>
        <button class="action primary checkout print" onclick="window.print()"><?= $escaper->escapeHtml(__("PRINT")) ?></button>
    </div>
    <script type="text/javascript">
        var lang = '<?= $escaper->escapeJs($block->getLang()) ?>';
        var hipaySdk = new HiPay({
            username: 'hosted',
            password: 'hosted',
            environment: 'production',
            lang: lang.length > 2 ? lang.substr(0, 2) : 'en'
        });
        <?php if ($referenceToPay['method'] === 'multibanco'): ?>
            hipaySdk.createReference('multibanco', {
                selector: 'referenceToPay',
                reference: '<?= $escaper->escapeJs($referenceToPay['reference']) ?>',
                entity: '<?= $escaper->escapeJs($referenceToPay['entity']) ?>',
                amount: '<?= $escaper->escapeJs($referenceToPay['amount']) ?>',
                expirationDate: '<?= $escaper->escapeJs($referenceToPay['expirationDate']) ?>',
            });
        <?php else: ?>
            hipaySdk.createReference('sisal', {
                selector: 'referenceToPay',
                reference: '<?= $escaper->escapeJs($referenceToPay['reference']) ?>',
                barCode: '<?= $escaper->escapeJs($referenceToPay['barCode']) ?>'
            });
        <?php endif ?>
    </script>
<?php endif ?>
<p><?= /* @escapeNotVerified */ __('Click <a href="%1">here</a> to continue shopping.', $escaper->escapeUrl($block->getContinueShoppingUrl())) ?>
</p>
